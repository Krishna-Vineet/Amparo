<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amparo AI - Register</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Light theme */
            --dark-bg: #F5F7FA;
            --dark-primary: #2A9D8F;
            --dark-text: #264653;
            --dark-accent1: #E9C46A;
            --dark-accent2: #F4A261;
            --dark-card: #FFFFFF;

            /* Dark theme */
            --light-bg: #121212;
            --light-primary: #BB86FC;
            --light-text: #E0E0E0;
            --light-accent1: #03DAC6;
            --light-accent2: #CF6679;
            --light-card: #1E1E1E;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            
            background: var(--light-bg);
            color: var(--light-text);
            transition: background-color 0.3s, color 0.3s;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        body.dark-theme {
            background: var(--dark-bg);
            color: var(--dark-text);
        }

        .register-container {
            background: var(--light-card);
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin: 2rem;
            width: 100%;
            max-width: 500px;
            animation: fadeIn 0.5s ease-out;
            position: relative;
            z-index: 10;
        }

        .dark-theme .register-container {
            background: var(--dark-card);
        }

        .register-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .register-header h1 {
            margin: 0;
            font-size: 1.75rem;
            color: var(--light-primary);
        }

        .dark-theme .register-header h1 {
            color: var(--dark-primary);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .form-input {
            width: 95%;
            padding: 0.75rem;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 0.5rem;
            font-family: inherit;
            background: var(--light-bg);
            color: var(--light-text);
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--light-primary);
            box-shadow: 0 0 0 3px rgba(42, 157, 143, 0.2);
        }

        .dark-theme .form-input {
            background: var(--dark-bg);
            color: var(--dark-text);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .dark-theme .form-input:focus {
            border-color: var(--dark-primary);
            box-shadow: 0 0 0 3px rgba(187, 134, 252, 0.2);
        }

        .password-container {
            position: relative;
        }

        .show-password {
            position: absolute;
            right: 10px;
            top: 70%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.3s;
        }

        .show-password:hover {
            opacity: 1;
        }

        .register-btn {
            width: 100%;
            padding: 0.75rem;
            background: var(--light-primary);
            color: white;
            border: none;
            border-radius: 2rem;
            cursor: pointer;
            font-weight: 600;
            transition: transform 0.2s, background 0.3s;
        }

        .register-btn:hover {
            transform: scale(1.02);
        }

        .dark-theme .register-btn {
            background: var(--dark-primary);
        }

        .login-link {
            text-align: center;
            margin-top: 1rem;
            font-size: 0.875rem;
        }

        .login-link a {
            color: var(--light-text);
            text-decoration: none;
            transition: color 0.3s;
        }

        .login-link a:hover {
            color: var(--light-primary);
        }

        .dark-theme .login-link a {
            color: var(--dark-text);
        }

        .dark-theme .login-link a:hover {
            color: var(--dark-primary);
        }

        .section-header {
            font-weight: 600;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            font-size: 1.1rem;
            color: var(--light-primary);
        }

        .dark-theme .section-header {
            color: var(--dark-primary);
        }

        #theme-toggle {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            border: none;
            background: var(--light-primary);
            color: white;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
        }

        .dark-theme #theme-toggle {
            background: var(--dark-primary);
        }

        @keyframes float {
            0% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .background-animation {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            filter: blur(3px);
            opacity: 0.5;
            z-index: -1;
        }

        .doodle {
            position: absolute;
            font-size: 20px;
            opacity: 0.1;
            animation: float 10s infinite linear;
        }
    </style>
</head>
<body>
    <div class="background-animation"></div>
    <div class="register-container">
        <div class="register-header">
            <h1>Create Your Amparo Account</h1>
        </div>                           
        <form id="registerForm">
            <div class="form-group">
                <label for="fullName" class="form-label">Full Name</label>
                <input type="text" id="fullName" class="form-input" required placeholder="Enter your full name">
            </div>
            <div class="form-group">
                <label for="phone" class="form-label">Phone Number</label>
                <input type="tel" id="phone" class="form-input" required placeholder="Enter your phone number">
            </div>
            
            <!-- <div class="form-group">
                <label for="otp" class="form-label">OTP Verification</label>
                <div style="display: flex; gap: 5px;">
                    <input type="tel" id="otp" class="form-input" required placeholder="Enter OTP" style="flex-grow: 1;">
                    <button type="button" id="sendOTP" class="register-btn" style=" padding: 0 1rem;">Send OTP</button>
                </div>
            </div> -->

            <div class="form-group password-container">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" class="form-input" required placeholder="Create a strong password">
                <button type="button" class="show-password" id="togglePassword">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>

            <div class="section-header">Emergency Contact</div>
            <div class="form-group">
                <label for="emergencyName" class="form-label">Contact Name</label>
                <input type="text" id="emergencyName" class="form-input" required placeholder="Enter emergency contact name">
            </div>
            <div class="form-group">
                <label for="emergencyPhone" class="form-label">Contact Phone</label>
                <input type="tel" id="emergencyPhone" class="form-input" required placeholder="Enter emergency contact phone">
            </div>
            <div class="form-group">
                <label for="emergencyRelation" class="form-label">Relation</label>
                <input type="text" id="emergencyRelation" class="form-input" required placeholder="Relationship to contact">
            </div>

            <div class="form-group">
                <label for="medicalIssues" class="form-label">Medical Issues (Optional)</label>
                <textarea id="medicalIssues" class="form-input" rows="3" placeholder="List any known medical conditions"></textarea>
            </div>

            <button type="submit" class="register-btn">Register</button>
            <div class="login-link">
                Already have an account? <a href="/login" id="loginLink">Login</a>
            </div>
        </form>
    </div>

    <button id="theme-toggle">Toggle Theme</button>

    <script>
        // Background doodles animation
        function createDoodles() {
            const shapes = ['●', '■', '▲', '◆'];
            const container = document.querySelector('.background-animation');
            
            for (let i = 0; i < 20; i++) {
                const doodle = document.createElement('div');
                doodle.className = 'doodle';
                doodle.textContent = shapes[Math.floor(Math.random() * shapes.length)];
                doodle.style.left = `${Math.random() * 100}%`;
                doodle.style.top = `${Math.random() * 100}%`;
                doodle.style.fontSize = `${Math.random() * 20 + 10}px`;
                doodle.style.animation = `float ${Math.random() * 10 + 5}s infinite linear`;
                container.appendChild(doodle);
            }
        }
    
        
        // Theme toggle
        const themeToggle = document.getElementById('theme-toggle');
        const body = document.body;

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-theme');
        });

        // Password toggle
        const passwordInput = document.getElementById('password');
        const togglePasswordBtn = document.getElementById('togglePassword');

        togglePasswordBtn.addEventListener('click', () => {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
        });

        // // OTP Send functionality (placeholder)
        // const sendOTPBtn = document.getElementById('sendOTP');
        // const phoneInput = document.getElementById('phone');

        // sendOTPBtn.addEventListener('click', () => {
        //     const phone = phoneInput.value;
        //     if (phone) {
        //         // Placeholder for OTP sending logic
        //         console.log('Sending OTP to:', phone);
        //         alert('OTP sent! Check your phone.');
        //     } else {
        //         alert('Please enter a phone number first.');
        //     }
        // });

        // Registration form submission
        const registerForm = document.getElementById('registerForm');
registerForm.addEventListener('submit', async (e) => {
    e.preventDefault(); // Prevent the default form submission behavior

    // Collect form data
    const formData = {
        name: document.getElementById('fullName').value,
        phone: document.getElementById('phone').value,
        password: document.getElementById('password').value,
        emergencyContacts: [
            {
                name: document.getElementById('emergencyName').value,
                phone: document.getElementById('emergencyPhone').value,
                relation: document.getElementById('emergencyRelation').value
            }
        ],
        medicalIssues: document.getElementById('medicalIssues').value.split(',').map(issue => issue.trim()) // Split into array
    };

    try {
        // Send the data to the backend using fetch
        const response = await fetch('/register', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json' // Specify that we're sending JSON
            },
            body: JSON.stringify(formData) // Convert the form data to JSON
        });

        // Parse the response as JSON
        const result = await response.json();

        if (response.ok) {
            // Registration successful
            alert('Registration successful!');
            console.log('Server response:', result);
            window.location.href = '/login'; // Redirect to login page after successful registration
        } else {
            // Handle errors from the server
            alert(`Error: ${result.message}`);
            console.error('Error during registration:', result);
        }
    } catch (error) {
        // Handle network errors or other issues
        console.error('Network error:', error);
        alert('An error occurred while trying to register. Please try again.');
    }
});

        // Background animation
        function createDoodles() {
            const shapes = ['●', '■', '▲', '◆'];
            const container = document.createElement('div');
            container.className = 'background-animation';
            
            for (let i = 0; i < 20; i++) {
                const doodle = document.createElement('div');
                doodle.className = 'doodle';
                doodle.textContent = shapes[Math.floor(Math.random() * shapes.length)];
                doodle.style.cssText = `
                    left: ${Math.random() * 100}%;
                    top: ${Math.random() * 100}%;
                    font-size: ${Math.random() * 20 + 10}px;
                `;
                container.appendChild(doodle);
            }
            
            document.body.appendChild(container);
        }

        createDoodles();
    </script>
</body>
</html>


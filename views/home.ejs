<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amparo AI</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Light theme */
            --dark-bg: #F5F7FA;
            --dark-primary: #2A9D8F;
            --dark-text: #264653;
            --dark-accent1: #E9C46A;
            --dark-accent2: #F4A261;

            /* Dark theme */
            --light-bg: #121212;
            --light-primary: #BB86FC;
            --light-text: #E0E0E0;
            --light-accent1: #03DAC6;
            --light-accent2: #CF6679;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: var(--light-bg);
            color: var(--light-text);
            transition: background-color 0.3s, color 0.3s;
        }

        body.dark-theme {
            background: var(--dark-bg);
            color: var(--dark-text);
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--light-primary);
        }

        .dark-theme .logo {
            color: var(--dark-primary);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-link {
            color: var(--light-text);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
        }

        .dark-theme .nav-link {
            color: var(--dark-text);
        }

        .nav-link:hover {
            color: var(--light-primary);
        }

        .dark-theme .nav-link:hover {
            color: var(--dark-primary);
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            background: rgba(0, 0, 0, 0.1);
            cursor: pointer;
        }

        .main-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .background-animation {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
        }

        .mic-container {
            position: relative;
            width: 120px;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .mic-icon {
            width: 64px;
            height: 64px;
            color: var(--light-primary);
            animation: pulse 2s infinite;
        }

        .dark-theme .mic-icon {
            color: var(--dark-primary);
        }

        .aura-ball {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: var(--light-primary);
            opacity: 0;
            transform: scale(0);
            transition: all 0.3s;
        }

        .dark-theme .aura-ball {
            background: var(--dark-primary);
        }

        .aura-ball.active {
            opacity: 0.3;
            transform: scale(1);
            animation: aura-pulse 1.5s infinite;
        }

        .conversation-container {
            width: 100%;
            max-width: 600px;
            margin: 2rem auto;
            height: 300px;
            overflow-y: auto;
            padding: 1rem;
        }

        .message {
            margin: 1rem 0;
            padding: 1rem;
            border-radius: 1rem;
            max-width: 80%;
        }

        .user-message {
            background: var(--light-primary);
            color: white;
            margin-left: auto;
        }

        .ai-message {
            background: rgba(0, 0, 0, 0.1);
            margin-right: auto;
        }

        .input-container {
            width: 100%;
            max-width: 600px;
            margin: 1rem auto;
            position: relative;
        }

        .text-input {
            width: 100%;
            padding: 1rem;
            border: none;
            border-radius: 1rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            color: var(--light-text);
            font-size: 1rem;
        }

        .dark-theme .text-input {
            color: var(--dark-text);
        }

        .disclaimer {
            position: fixed;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.8rem;
            opacity: 0.7;
            text-align: center;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        @keyframes aura-pulse {
            0% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.2); opacity: 0.1; }
            100% { transform: scale(1); opacity: 0.3; }
        }

        .doodle {
            position: absolute;
            opacity: 0.1;
            pointer-events: none;
        }

        #theme-toggle {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            border: none;
            background: var(--light-primary);
            color: white;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
        }

        .dark-theme #theme-toggle {
            background: var(--dark-primary);
        }

        .listening {
            animation: pulse 1.5s infinite;
        }

        .text-input {
            width: 100%;
            padding: 1rem;
            border: none;
            border-radius: 1rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            color: var(--light-text);
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .speech-status {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.8rem;
            color: var(--light-primary);
        }

        /* SOS Alert UI */
        .sos-alert-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(239, 71, 111, 0.9);
            z-index: 9999;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            animation: pulse-bg 1s infinite;
        }

        @keyframes pulse-bg {
            0% { background: rgba(239, 71, 111, 0.9); }
            50% { background: rgba(239, 71, 111, 1); }
            100% { background: rgba(239, 71, 111, 0.9); }
        }

        .sos-content {
            text-align: center;
            padding: 2rem;
        }

        .sos-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
            animation: scale-up 0.5s infinite alternate;
        }

        @keyframes scale-up {
            from { transform: scale(1); }
            to { transform: scale(1.2); }
        }

        .sos-title {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .sos-number {
            font-size: 1.5rem;
            opacity: 0.9;
        }

        .close-sos {
            margin-top: 2rem;
            padding: 1rem 2rem;
            background: white;
            color: #EF476F;
            border: none;
            border-radius: 2rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .close-sos:hover {
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="logo">Amparo</div>
        <div class="nav-links">
            <a href="/medicine" class="nav-link">Medicine</a>
            <a href="/reminder" class="nav-link">Reminders</a>
            <a href="/profile" class="nav-link">
                <div class="profile">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <!-- <span>Sunaina</span> -->
                </div>
            </a>
        </div>
    </nav>

    <div id="sos-alert" class="sos-alert-overlay">
        <div class="sos-content">
            <div class="sos-icon">🆘</div>
            <div class="sos-title">SOS TRIGGERED</div>
            <div class="sos-number" id="sos-recipient">Calling: ---</div>
            <div style="margin-top: 1rem;">Simulation Active - No real call placed.</div>
            <button class="close-sos" onclick="hideSOS()">DISMISS</button>
        </div>
    </div>

    <main class="main-content">
        <div class="background-animation"></div>
        
        <div class="conversation-container" id="conversation">
            <!-- Messages will be added here dynamically -->
        </div>

        <div class="mic-container" id="start-btn">
            <svg class="mic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="23"></line>
                <line x1="8" y1="23" x2="16" y2="23"></line>
            </svg>
            <div class="aura-ball"></div>
        </div>

        <div class="input-container">
            <input type="text" class="text-input" placeholder="Type your message..." id="textInput">
        </div>

        <p class="disclaimer">This is an AI. Please do not take responses as professional advice.</p>
    </main>

    <button id="theme-toggle">Toggle Theme</button>

    <script>
        // Background doodles animation
        function createDoodles() {
            const shapes = ['●', '■', '▲', '◆'];
            const container = document.querySelector('.background-animation');
            
            for (let i = 0; i < 20; i++) {
                const doodle = document.createElement('div');
                doodle.className = 'doodle';
                doodle.textContent = shapes[Math.floor(Math.random() * shapes.length)];
                doodle.style.left = `${Math.random() * 100}%`;
                doodle.style.top = `${Math.random() * 100}%`;
                doodle.style.fontSize = `${Math.random() * 20 + 10}px`;
                doodle.style.animation = `float ${Math.random() * 10 + 5}s infinite linear`;
                container.appendChild(doodle);
            }
        }
    
        // DOM Elements
        const micContainer = document.getElementById('start-btn');
        const auraBall = document.querySelector('.aura-ball');
        const conversation = document.getElementById('conversation');
        const textInput = document.getElementById('textInput');
        const themeToggle = document.getElementById('theme-toggle');
    
        // Speech Recognition Setup
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition;
        let isListening = false; // true when mic is turned on
        let speaking = false;    // true when TTS is playing
        let idleTimeout;
    
        function addMessage(text, isUser = false) {
            if (isUser) {
                console.log("User: ", text);
            } else {
                console.log("Amparo: ", text);
            }
            // console.log("Adding message:", text);
            const message = document.createElement('div');
            message.className = `message ${isUser ? 'user-message' : 'ai-message'}`;
            message.textContent = text;
            conversation.appendChild(message);
            conversation.scrollTop = conversation.scrollHeight;
        }
    
        function setupSpeechRecognition() {
            if (!SpeechRecognition) {
                alert("Your browser doesn't support Speech Recognition. Please use Chrome.");
                return;
            }
    
            recognition = new SpeechRecognition();
            // Using continuous recognition with interim results so you see what you say.
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';
    
            recognition.onresult = (event) => {
                let finalTranscript = '';
                let interimTranscript = '';
                for (let i = event.resultIndex; i < event.results.length; i++) {
                    const transcript = event.results[i][0].transcript;
                    if (event.results[i].isFinal) {
                        finalTranscript += transcript;
                    } else {
                        interimTranscript += transcript;
                    }
                }
                // Update the text input with the recognized text.
                textInput.value = finalTranscript || interimTranscript;
    
                // Reset idle timer on every result.
                if (idleTimeout) clearTimeout(idleTimeout);
                idleTimeout = setTimeout(() => {
                    console.log("No speech detected for 1.5 seconds. Stopping recognition.");
                    recognition.stop();
                }, 1500);
            };
    
            recognition.onend = () => {
                clearTimeout(idleTimeout);
                // If mic is still on (isListening) and TTS is not playing, send message if available.
                if (isListening && !speaking) {
                    const message = textInput.value.trim();
                    if (message) {
                        textInput.value = '';
                        sendMessage(message);
                    }
                } else {
                    // Update UI when recognition is off.
                    auraBall.classList.remove('active');
                    micContainer.classList.remove('listening');
                }
            };
    
            recognition.onerror = (event) => {
                console.error('Speech recognition error:', event.error);
                isListening = false;
                auraBall.classList.remove('active');
                micContainer.classList.remove('listening');
            };
        }
    
        // Text to Speech Setup
        function setupTextToSpeech() {
            if (!('speechSynthesis' in window)) {
                console.error("Your browser doesn't support speech synthesis.");
                return;
            }
            window.speechSynthesis.onvoiceschanged = () => {
                window.speechSynthesis.getVoices();
            };
        }
    
        function speakText(text) {
            // console.log("Speaking text:", text);
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 1;
            utterance.pitch = 1;
            speaking = true;
            // When TTS finishes, if the mic is still active, restart recognition.
            utterance.onend = () => {
                speaking = false;
                if (isListening) {
                    recognition.start();
                    auraBall.classList.add('active');
                    micContainer.classList.add('listening');
                }
            };
            window.speechSynthesis.speak(utterance);
        }
    
        // Message Handling
        async function sendMessage(text) {
            // Add the user's message to the chat.
            addMessage(text, true);
            // Stop recognition while processing.
            recognition.stop();
            auraBall.classList.remove('active');
            micContainer.classList.remove('listening');
            
            try {
                // Send the text to the backend.
                const response = await fetch('/aiwork', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ text: text })
                });
                const data = await response.json();
                
                let displayResponse = data.response;
                
                // Check if it's a mocked SOS alert
                if (displayResponse.startsWith('MOCK_SOS:')) {
                    const number = displayResponse.split('for ')[1] || 'Emergency Contacts';
                    showSOS(number);
                    displayResponse = "I have triggered an emergency alert for you. Help is on the way.";
                }

                // Add AI's response to the chat.
                addMessage(displayResponse, false);
                // Speak the response.
                speakText(displayResponse);
            } catch (error) {
                console.error('Error:', error);
                addMessage('Sorry, there was an error processing your message.', false);
            }
            // Clear the input.
            textInput.value = '';
        }
    
        // Mic Button Event Listener
        micContainer.addEventListener('click', () => {
            // If mic is already on, turn it off.
            if (isListening) {
                isListening = false;
                recognition.stop();
                auraBall.classList.remove('active');
                micContainer.classList.remove('listening');
                // If TTS is playing, cancel it.
                if (speaking) {
                    window.speechSynthesis.cancel();
                    speaking = false;
                }
            } else {
                // Turn the mic on.
                isListening = true;
                if (!speaking) {
                    recognition.start();
                }
                auraBall.classList.add('active');
                micContainer.classList.add('listening');
            }
        });
    
        // Allow sending message by pressing Enter in the text input.
        textInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && textInput.value.trim()) {
                sendMessage(textInput.value.trim());
                textInput.value = '';
            }
        });
    
        // Theme toggle
        themeToggle.addEventListener('click', () => {
            document.body.classList.toggle('dark-theme');
        });
    
        // SOS Alert handling
        function showSOS(number) {
            document.getElementById('sos-recipient').textContent = `Simulating Call to: ${number}`;
            document.getElementById('sos-alert').style.display = 'flex';
        }

        function hideSOS() {
            document.getElementById('sos-alert').style.display = 'none';
        }

        // Initialize everything
        setupSpeechRecognition();
        setupTextToSpeech();
        createDoodles();
    
        // Add an initial greeting message.
        setTimeout(() => {
            addMessage('Hello! How can I assist you today?', false);
        }, 1000);
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amparo AI - Login</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Light theme */
            --dark-bg: #F5F7FA;
            --dark-primary: #2A9D8F;
            --dark-text: #264653;
            --dark-accent1: #E9C46A;
            --dark-accent2: #F4A261;
            --dark-card: #FFFFFF;

            /* Dark theme */
            --light-bg: #121212;
            --light-primary: #BB86FC;
            --light-text: #E0E0E0;
            --light-accent1: #03DAC6;
            --light-accent2: #CF6679;
            --light-card: #1E1E1E;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: var(--light-bg);
            color: var(--light-text);
            transition: background-color 0.3s, color 0.3s;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        body.dark-theme {
            background: var(--dark-bg);
            color: var(--dark-text);
        }

        .login-container {
            background: var(--light-card);
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            width: 100%;
            max-width: 400px;
            animation: fadeIn 0.5s ease-out;
            position: relative;
            z-index: 10;
        }

        .dark-theme .login-container {
            background: var(--dark-card);
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-header h1 {
            margin: 0;
            font-size: 1.75rem;
            color: var(--light-primary);
        }

        .dark-theme .login-header h1 {
            color: var(--dark-primary);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .form-input {
            width: 95%;
            padding: 0.75rem;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 0.5rem;
            font-family: inherit;
            background: var(--light-bg);
            color: var(--light-text);
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--light-primary);
            box-shadow: 0 0 0 3px rgba(42, 157, 143, 0.2);
        }

        .dark-theme .form-input {
            background: var(--dark-bg);
            color: var(--dark-text);
            border-color: rgba(255, 255, 255, 0.1);
        }
        .background-animation {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
        }


        .dark-theme .form-input:focus {
            border-color: var(--dark-primary);
            box-shadow: 0 0 0 3px rgba(187, 134, 252, 0.2);
        }

        .password-container {
            position: relative;
        }

        .show-password {
            position: absolute;
            right: 10px;
            top: 70%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.3s;
        }

        .show-password:hover {
            opacity: 1;
        }

        .login-btn {
            width: 100%;
            padding: 0.75rem;
            background: var(--light-primary);
            color: white;
            border: none;
            border-radius: 2rem;
            cursor: pointer;
            font-weight: 600;
            transition: transform 0.2s, background 0.3s;
        }

        .login-btn:hover {
            transform: scale(1.02);
        }

        .dark-theme .login-btn {
            background: var(--dark-primary);
        }

        .login-links {
            display: flex;
            justify-content: space-between;
            margin-top: 1rem;
            font-size: 0.875rem;
        }

        .login-links a {
            color: var(--light-text);
            text-decoration: none;
            transition: color 0.3s;
        }

        .login-links a:hover {
            color: var(--light-primary);
        }

        .dark-theme .login-links a {
            color: var(--dark-text);
        }

        .dark-theme .login-links a:hover {
            color: var(--dark-primary);
        }

        #theme-toggle {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            border: none;
            background: var(--light-primary);
            color: white;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
        }

        .dark-theme #theme-toggle {
            background: var(--dark-primary);
        }

        @keyframes float {
            0% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .background-animation {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            filter: blur(3px);
            opacity: 0.5;
            z-index: -1;
        }

        .doodle {
            position: absolute;
            font-size: 20px;
            opacity: 0.1;
            animation: float 10s infinite linear;
        }
    </style>
</head>
<body>
    <div class="background-animation"></div>
    <div class="login-container">
        <div class="login-header">
            <h1>Welcome to Amparo</h1>
        </div>
        <form id="loginForm">
            <div class="form-group">
                <label for="phone" class="form-label">Phone Number</label>
                <input type="tel" id="phone" class="form-input" required placeholder="Enter your phone number">
            </div>
            <div class="form-group password-container">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" class="form-input" required placeholder="Enter your password">
                <button type="button" class="show-password" id="togglePassword">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>
            <button type="submit" class="login-btn">Login</button>
            <div class="login-links">
                <a href="#" id="forgotPassword">Forgot Password?</a>
                <a href="/register" id="registerLink">Register</a>
            </div>
        </form>
    </div>

    <button id="theme-toggle">Toggle Theme</button>

    <script>
        // Background doodles animation
        function createDoodles() {
            const shapes = ['●', '■', '▲', '◆'];
            const container = document.querySelector('.background-animation');
            
            for (let i = 0; i < 20; i++) {
                const doodle = document.createElement('div');
                doodle.className = 'doodle';
                doodle.textContent = shapes[Math.floor(Math.random() * shapes.length)];
                doodle.style.left = `${Math.random() * 100}%`;
                doodle.style.top = `${Math.random() * 100}%`;
                doodle.style.fontSize = `${Math.random() * 20 + 10}px`;
                doodle.style.animation = `float ${Math.random() * 10 + 5}s infinite linear`;
                container.appendChild(doodle);
            }
        }
    
        
        // Theme toggle
        const themeToggle = document.getElementById('theme-toggle');
        const body = document.body;

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-theme');
        });

        // Password toggle
        const passwordInput = document.getElementById('password');
        const togglePasswordBtn = document.getElementById('togglePassword');

        togglePasswordBtn.addEventListener('click', () => {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
        });

        // Login form submission
        const loginForm = document.getElementById('loginForm');
loginForm.addEventListener('submit', async (e) => {
    e.preventDefault(); // Prevent the default form submission behavior

    // Collect form data
    const phone = document.getElementById('phone').value;
    const password = document.getElementById('password').value;

    try {
        // Send the data to the backend using fetch
        const response = await fetch('/login', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json' // Specify that we're sending JSON
            },
            body: JSON.stringify({ phone, password }), // Convert the form data to JSON
            credentials: 'include'
        });

        // Parse the response as JSON
        const result = await response.json();

        
        if (response.ok) {
            // console.log(response);
            
            // // Login successful
            // alert('Login successful!');
        

            // Store the token (e.g., in localStorage)
         

            // Redirect to the home page after successful login
            window.location.href = '/';
        } else {
            // Handle errors from the server
            alert(`Error: ${result.message}`);
            console.error('Error during login:', result);
        }
    } catch (error) {
        // Handle network errors or other issues
        console.error('Network error:', error);
        alert('An error occurred while trying to log in. Please try again.');
    }
});

        // Background animation
        function createDoodles() {
            const shapes = ['●', '■', '▲', '◆'];
            const container = document.createElement('div');
            container.className = 'background-animation';
            
            for (let i = 0; i < 20; i++) {
                const doodle = document.createElement('div');
                doodle.className = 'doodle';
                doodle.textContent = shapes[Math.floor(Math.random() * shapes.length)];
                doodle.style.cssText = `
                    left: ${Math.random() * 100}%;
                    top: ${Math.random() * 100}%;
                    font-size: ${Math.random() * 20 + 10}px;
                `;
                container.appendChild(doodle);
            }
            
            document.body.appendChild(container);
        }

        createDoodles();
    </script>
</body>
</html>